# Environment
NODE_ENV=development

# Server
PORT=3001
HOST=0.0.0.0

# Worker
WORKER_PORT=3002
WORKER_CONCURRENCY=2

# Storage
STORAGE_DIR=./data
JOBS_DIR=./data/jobs
WORKSPACES_DIR=./data/workspaces
ARTIFACTS_DIR=./data/artifacts

# Limits
MAX_UPLOAD_SIZE_MB=100
CLONE_TIMEOUT_MS=60000
INSTALL_TIMEOUT_MS=120000
BUILD_TIMEOUT_MS=180000
RENDER_TIMEOUT_MS=60000
MAX_ROUTES_PER_JOB=50

# Playwright
PLAYWRIGHT_HEADLESS=true
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900

# Security
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_LIMIT_MB=2048
MAX_FILE_COUNT=10000
MAX_UNZIP_SIZE_MB=500
